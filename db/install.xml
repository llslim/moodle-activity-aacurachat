<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/aacurachat/db" VERSION="20240303" COMMENT="XMLDB file for Moodle mod geniai"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="aacurachat" COMMENT="Stores course certificate activity module instances.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="scenariocode" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="anna" SEQUENCE="false" COMMENT="Unique code of the active roleplay scenario"/>
        <FIELD NAME="min_turns" TYPE="int" LENGTH="6" NOTNULL="false" DEFAULT="8" SEQUENCE="false" COMMENT="Per-activity override for min student turns before grading (0 = use global)"/>
        <FIELD NAME="parent_intensity" TYPE="char" LENGTH="20" NOTNULL="false" SEQUENCE="false" COMMENT="Per-activity parent assertiveness/aggressiveness level override (empty = global)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
